{
  "name": "free-session-manager",
  "version": "1.1.5",
  "description": "Application de bureau et gestionnaire de sessions multi-agents 100% gratuit dédié aux modèles de Kilo, OpenCode et OpenRouter.",
  "repository": "https://github.com/khalilbenaz/free-session-manager",
  "bin": {
    "fsm": "bin/sm.js",
    "free-session-manager": "bin/sm.js",
    "openrouter-agent": "bin/openrouter-agent.js"
  },
  "main": "electron/main.js",
  "files": [
    "bin/",
    "lib/",
    "public/",
    "scripts/",
    "electron/",
    "server.js",
    "pick-folder.ps1",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/run-all-tests.js",
    "postinstall": "node scripts/postinstall.js",
    "start": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac --arm64",
    "install:app": "npm run dist:mac && rm -rf \"/Applications/Free Session Manager.app\" && cp -R \"dist.noindex/mac-arm64/Free Session Manager.app\" /Applications/",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "free-session-manager",
    "kilo",
    "opencode",
    "openrouter",
    "free-models",
    "terminal",
    "sessions"
  ],
  "author": {
    "name": "Khalil Benazzouz"
  },
  "license": "MIT",
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "@openrouter/sdk": "^1.3.33",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "productName": "Free Session Manager",
  "build": {
    "appId": "com.free-session-manager.app",
    "productName": "Free Session Manager",
    "copyright": "Free Session Manager",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "files": [
      "bin/**",
      "lib/**",
      "public/**",
      "scripts/**",
      "electron/**",
      "server.js",
      "pick-folder.ps1",
      "package.json",
      "!**/*.pdb",
      "!**/*.map",
      "!test/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Free-Session-Manager-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Free Session Manager ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Free-Session-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Free Session Manager",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Khalil Benazzouz <khalilbenaz@users.noreply.github.com>",
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "Free-Session-Manager-${version}-${arch}.${ext}"
    },
    "deb": {
      "synopsis": "Free Session Manager — sessions Kilo, OpenCode et OpenRouter",
      "description": "Une fenêtre pour piloter plusieurs sessions d’agents IA gratuits (Kilo, OpenCode, OpenRouter) en parallèle."
    }
  }
}
